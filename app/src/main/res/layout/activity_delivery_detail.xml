<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDetailTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalle de la Entrega"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1E293B"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvClientNameDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliente: Loading..."
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <TextView
                android:id="@+id/tvPhonoDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Teléfono: -"
                android:textColor="#64748B"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvAddressDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Dirección: -"
                android:textColor="#64748B"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvAmountDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Monto a cobrar: $0"
                android:textColor="#0284C7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatusDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Estado Actual: PENDIENTE"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvObservationDetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Notas: -"
                android:textColor="#64748B"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnMarkDelivered"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="MARCAR COMO ENTREGADO"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnMarkCanceled"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="MARCAR COMO CANCELADO"
            android:textColor="#EF4444"
            android:textSize="15sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnDeleteDelivery"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Eliminar Registro de SQLite"
            android:textColor="#64748B"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>